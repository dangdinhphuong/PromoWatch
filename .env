# Server
PORT=4000
NODE_ENV=development

# Supabase
VITE_SUPABASE_URL=https://xevaudgnigtwqcmtjgst.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_MABncg93aXZKDRdvnyNOug_bOdruIMJ
SUPABASE_URL=https://xevaudgnigtwqcmtjgst.supabase.co
SUPABASE_API_KEY=sb_publishable_MABncg93aXZKDRdvnyNOug_bOdruIMJ
# Khuyen nghi dung service role key cho server-side sync (uu tien hon SUPABASE_API_KEY)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROMOTIONS_TABLE=np_promotions
SUPABASE_PROMOTIONS_ENABLED=true

# MongoDB (optional)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=webtoolkit
MONGO_PROMOTIONS_ENABLED=true
PROMOTIONS_CRAWL_ENABLED=true
PROMOTIONS_CRAWL_API_URL=http://localhost:4000/api/promotions/data
PROMOTIONS_CRAWL_SCHEDULE=*/1 * * * *
PROMOTIONS_CLEANUP_ENABLED=false
PROMOTIONS_CLEANUP_SCHEDULE=*/1 * * * *
PROMOTIONS_CLEANUP_TIMEZONE=Asia/Bangkok

# External API allowlist (comma-separated hostnames)
API_ALLOWLIST=api.github.com

# Cron
CRON_ENABLED=true
CRON_SCHEDULE=*/1 * * * *
CRON_DB_PING=false
CRON_SERIAL=true

# Dichvucong crawler
DVC_RECORDS_PER_PAGE=500
DVC_MAX_PAGES=0
DVC_CRON_ENABLED=false
DVC_CRON_SCHEDULE=*/1 * * * *
VTR_CRON_ENABLED=false
VTR_CRON_SCHEDULE=*/1 * * * *
BGG_CRON_ENABLED=false
BGG_CRON_SCHEDULE=*/1 * * * *
