# Server
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/promowatch

# MongoDB (optional)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=webtoolkit
MONGO_PROMOTIONS_ENABLED=true
PROMOTIONS_CRAWL_ENABLED=false
PROMOTIONS_CRAWL_API_URL=http://localhost:4000/api/promotions/data
PROMOTIONS_CRAWL_SCHEDULE=*/1 * * * *
PROMOTIONS_CLEANUP_ENABLED=true
PROMOTIONS_CLEANUP_SCHEDULE=0 2 * * *
PROMOTIONS_CLEANUP_TIMEZONE=Asia/Bangkok

# External API allowlist (comma-separated hostnames)
API_ALLOWLIST=api.github.com

# Cron
CRON_ENABLED=true
CRON_SCHEDULE=0 1 * * *
CRON_DB_PING=false
CRON_SERIAL=true

# Dichvucong crawler
DVC_RECORDS_PER_PAGE=500
DVC_MAX_PAGES=0
DVC_CRON_ENABLED=true
DVC_CRON_SCHEDULE=0 1 * * *
VTR_CRON_ENABLED=true
VTR_CRON_SCHEDULE=0 1 * * *
BGG_CRON_ENABLED=true
BGG_CRON_SCHEDULE=0 1 * * *
